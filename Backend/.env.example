# ─────────────────────────────────────────────────────────────────────────────
# Tallow Care — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/tallow-care

# ── Auth / JWT ────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_minimum_32_chars
JWT_EXPIRES_IN=7d

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id

# ── Cloudflare Turnstile ──────────────────────────────────────────────────────
TURNSTILE_SECRET_KEY=your_turnstile_secret

# ── Frontend URL (for CORS) ───────────────────────────────────────────────────
CLIENT_URL=https://your-frontend.vercel.app

# ── Brevo (Sendinblue) Email API ──────────────────────────────────────────────
# Get your API key from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your_brevo_api_key_here

# The FROM address shown to recipients.
# ⚠️  MUST be verified in Brevo → Senders & IPs → Domains/Senders.
# ⚠️  Do NOT use a plain Gmail address here — Gmail blocks sending via Brevo
#     unless you authenticate your domain (SPF + DKIM).
# Use: noreply@yourdomain.com  OR  the free Brevo alias  <yourname>@<yourbrevodomain>.com
BREVO_SENDER_EMAIL=noreply@yourdomain.com

# Display name shown in the "From" field
BREVO_SENDER_NAME=Tallow Care

# ─────────────────────────────────────────────────────────────────────────────
# REMOVED (no longer needed — everything uses Brevo now):
#   GMAIL_USER, GMAIL_APP_PASSWORD, MY_EMAIL, MY_APP_PASSWORD,
#   EMAIL, EMAIL_PASS, EMAIL_VERIFY_API_KEY, NUMVERIFY_API_KEY
# ─────────────────────────────────────────────────────────────────────────────
